---
// Weapon page template. One Markdown file in src/content/weapons/ = one page.
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import StatBar from "../../components/StatBar.astro";

export async function getStaticPaths() {
  const weapons = await getCollection("weapons");
  return weapons.map((weapon) => ({ params: { slug: weapon.id }, props: { weapon } }));
}

const { weapon } = Astro.props;
const w = weapon.data;
const { Content } = await render(weapon);
---

<Base title={w.name} description={w.summary}>
  <PageHead title={w.name} eyebrow={w.class} lede={w.summary} crumbs={[{ label: "Weapons", href: "weapons/" }, { label: w.name }]}>
    <ul class="tags" aria-label="At a glance">
      <li class="chip">{w.calibre}</li>
      {w.slots.map((s) => <li class="chip">{s} slot</li>)}
    </ul>
  </PageHead>

  <section class="section section--tight">
    <div class="wrap top">
      <figure class="case panel">
        <span class="case-label" aria-hidden="true">{w.name} · {w.calibre}</span>
        <Img src={w.image} alt={w.imageAlt ?? w.name} width={480} height={192} loading="eager" placeholder={`${w.name} inventory image`} />
      </figure>

      <div class="panel spec-panel">
        <h2 class="eyebrow eyebrow--plain">Specification</h2>
        <dl class="specs">
          {
            w.specs.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {
    w.hero && (
      <section class="wrap hero-shot" aria-label="In the game">
        <Img src={w.hero.src} alt={w.hero.alt} placeholder={`${w.name}: an in-game shot`} sizes="(min-width: 1200px) 1200px, 100vw" />
      </section>
    )
  }

  <section class="section section--tight">
    <div class="wrap two">
      <div class="panel stats">
        <h2>Stats</h2>
        <dl>
          {w.stats.map((s) => <StatBar label={s.label} value={s.value} display={s.display} />)}
        </dl>
        <p class="footnote">Rated out of 100, compared with other weapons in the game.</p>
      </div>

      <div class="stack">
        {
          w.fireModes.length > 0 && (
            <div class="panel block">
              <h2>Fire modes</h2>
              <ul class="modes">
                {w.fireModes.map((m) => (
                  <li>
                    <h3>{m.name}</h3>
                    <p>{m.text}</p>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="panel block">
          <h2>Controls</h2>
          <dl class="keys">
            {
              w.controls.map((c) => (
                <div>
                  <dt><kbd>{c.key}</kbd></dt>
                  <dd>{c.action}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap two">
      {
        w.recoil && (
          <div class="panel block">
            <h2>Recoil</h2>
            <p>{w.recoil.text}</p>
            <ul class="points">{w.recoil.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        )
      }
      {
        w.reload && (
          <div class="panel block">
            <h2>Reloading</h2>
            <p>{w.reload.text}</p>
            <ul class="points">{w.reload.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        )
      }
    </div>
  </section>

  {
    w.ammo.length > 0 && (
      <section class="section section--tight">
        <div class="wrap">
          <div class="section-head">
            <h2>Ammo</h2>
            {w.ammoSwitching && (
              <p class="switching">
                <kbd>T</kbd> {w.ammoSwitching}
              </p>
            )}
          </div>
          <ul class="ammo">
            {w.ammo.map((a) => (
              <li class:list={["panel", "round", { "round--planned": a.status === "planned" }]}>
                <span class="round-icon">
                  <Icon name="ammo" />
                </span>
                <div>
                  <h3>{a.name}</h3>
                  <p>{a.text}</p>
                  {(a.damage !== undefined || a.penetration !== undefined) && (
                    <dl class="round-stats">
                      {a.damage !== undefined && <StatBar label="Damage" value={a.damage} />}
                      {a.penetration !== undefined && <StatBar label="Penetration" value={a.penetration} />}
                    </dl>
                  )}
                </div>
                <span class:list={["chip", a.status === "planned" ? "chip--planned" : "chip--live"]}>{a.status === "planned" ? "Planned" : "In game"}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--tight">
    <div class="wrap">
      <article class="paper dossier">
        <span class="tape" aria-hidden="true"></span>
        <p class="dossier-stamp stamp">Field notes</p>
        <h2>The story</h2>
        <div class="dossier-body">
          <Content />
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .top {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 900px) {
    .top {
      grid-template-columns: 3fr 2fr;
    }
  }

  .case {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 280px;
    margin: 0;
    padding: 48px 24px;
    background-color: #191b1d;
    background-image:
      linear-gradient(to right, rgb(216 210 195 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(216 210 195 / 0.05) 1px, transparent 1px),
      radial-gradient(ellipse at center, rgb(216 210 195 / 0.07), transparent 70%);
    background-size: 48px 48px, 48px 48px, auto;
  }

  .case :global(img) {
    width: min(100%, 620px);
    filter: drop-shadow(0 18px 20px rgb(0 0 0 / 0.6));
  }

  .case-label {
    position: absolute;
    left: 16px;
    top: 12px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }

  .spec-panel {
    padding: 20px 22px 10px;
  }

  .spec-panel h2 {
    margin-bottom: 4px;
    font-size: 0.95rem;
  }

  .hero-shot {
    margin-block: 8px 16px;
  }

  .hero-shot :global(img),
  .hero-shot :global(.placeholder) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .two {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 900px) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
  }

  .stack {
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .stats,
  .block {
    padding: clamp(20px, 3vw, 28px);
  }

  .stats h2,
  .block h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .stats dl {
    margin: 0;
  }

  .footnote {
    margin: 14px 0 0;
    font-size: 0.9rem;
    color: var(--bone-faint);
  }

  .block p {
    color: var(--bone-dim);
  }

  .modes {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .modes li {
    padding-left: 14px;
    border-left: 3px solid var(--red);
  }

  .modes h3 {
    font-size: 1.25rem;
    margin-bottom: 0.2em;
  }

  .modes p {
    margin: 0;
  }

  .keys {
    margin: 0;
  }

  .keys div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px dashed var(--line-soft);
  }

  .keys dd {
    margin: 0;
    color: var(--bone-dim);
  }

  .points {
    margin: 0;
    padding-left: 1.1em;
  }

  .points li {
    margin-bottom: 6px;
  }

  .points li::marker {
    color: var(--red);
  }

  .switching {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .ammo {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .round {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    padding: 20px;
  }

  .round > .chip {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .round h3 {
    font-size: 1.4rem;
    margin-bottom: 0.3em;
  }

  .round p {
    margin: 0;
    color: var(--bone-dim);
  }

  .round-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line);
    background: var(--panel-3);
    color: var(--crate);
  }

  .round-icon :global(.icon) {
    width: 30px;
    height: 30px;
  }

  .round--planned {
    border-style: dashed;
    background-color: transparent;
  }

  .round--planned .round-icon {
    color: var(--bone-faint);
  }

  .round-stats {
    margin: 10px 0 0;
  }

  .chip--live {
    color: var(--green);
    border-color: var(--green-deep);
  }

  .dossier {
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(28px, 5vw, 56px);
    transform: rotate(-0.5deg);
  }

  .dossier .tape {
    top: -14px;
    left: 40px;
    rotate: -4deg;
  }

  .dossier h2 {
    color: var(--ink);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .dossier-stamp {
    position: absolute;
    right: clamp(16px, 4vw, 40px);
    top: clamp(16px, 4vw, 36px);
    color: #9c3423;
    border-color: #9c3423;
    transform: rotate(6deg);
  }

  .dossier-body {
    font-size: 1.12rem;
    line-height: 1.7;
    max-width: 62ch;
  }

  .dossier-body :global(p:first-child::first-letter) {
    float: left;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 3.6em;
    line-height: 0.8;
    margin: 0.06em 0.08em 0 0;
  }
</style>
