---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Img from "../../components/Img.astro";
import Gallery from "../../components/Gallery.astro";
import Untranslated from "../../components/Untranslated.astro";
import { langOf, link, t, formatDate } from "../../i18n";
import { devlogPaths } from "../../i18n/paths";

export function getStaticPaths() {
  return devlogPaths("en");
}

const lang = langOf(Astro.url);
const _ = t(lang);
const L = link(lang);
const { post, newer, older } = Astro.props;
const p = post.data;
const { Content } = await render(post.source);
---

<Base title={p.title} description={p.summary} image={p.cover?.src}>
  <PageHead title={p.title} lede={p.summary} crumbs={[{ label: _("Dev log"), href: "devlog/" }, { label: p.title }]} image={p.cover?.src}>
    <p class="meta">
      <time datetime={p.date.toISOString()}>{formatDate(lang, p.date)}</time>
      {p.version && <span class="chip chip--ver">{p.version}</span>}
    </p>
  </PageHead>

  <article class="section section--tight">
    <div class="wrap wrap--narrow">
      {
        p.cover && (
          <figure class="cover brushed">
            <Img src={p.cover.src} alt={p.cover.alt} loading="eager" sizes="(min-width: 860px) 780px, 100vw" />
          </figure>
        )
      }
      {!post.translated && <Untranslated />}
      <div class="prose">
        <Content />
      </div>
    </div>

    {
      p.screenshots.length > 0 && (
        <div class="wrap shots">
          <h2>{_("Screenshots")}</h2>
          <Gallery shots={p.screenshots} label={_("Screenshots for {title}", { title: p.title })} />
        </div>
      )
    }

    <nav class="wrap wrap--narrow pager" aria-label={_("More posts")}>
      {
        older && (
          <a class="panel pager-link" href={L(`devlog/${older.id}/`)}>
            <span>{_("Older")}</span>
            {older.data.title}
          </a>
        )
      }
      {
        newer && (
          <a class="panel pager-link pager-newer" href={L(`devlog/${newer.id}/`)}>
            <span>{_("Newer")}</span>
            {newer.data.title}
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 12px 0 0;
  }

  time {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--caption);
  }

  .cover {
    margin: 0 0 36px;
  }

  .cover :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .shots {
    margin-top: 56px;
  }

  .shots h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.3rem);
  }

  .pager {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin-top: 56px;
  }

  .pager-link {
    display: block;
    padding: 16px 18px;
    text-decoration: none;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 1.35rem;
    text-transform: uppercase;
  }

  .pager-link:hover {
    border-color: rgb(216 210 195 / 0.55);
  }

  .pager-link span {
    display: block;
    margin-bottom: 2px;
    font-family: var(--font-head);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    color: var(--dim);
  }

  .pager-newer {
    text-align: right;
    grid-column: -2;
  }
</style>
