---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Img from "../../components/Img.astro";
import { url, formatDate } from "../../lib/url";

const posts = (await getCollection("devlog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const roadmap = (await getCollection("roadmap")).map((r) => r.data).sort((a, b) => a.order - b.order);
---

<Base title="Dev log and roadmap" description="What's changed in The Home Counties, with screenshots, and what's coming next.">
  <PageHead
    title="Dev log"
    eyebrow="From the build"
    lede="Updates from development, newest first, with the roadmap at the bottom."
    crumbs={[{ label: "Dev log" }]}
    image="images/screenshots/2026-10-25-122647.webp"
  >
    <a class="btn btn--small jump" href="#roadmap">Jump to the roadmap</a>
  </PageHead>

  <section class="section section--tight" aria-label="Posts">
    <div class="wrap">
      <ol class="posts">
        {
          posts.map((p) => (
            <li class="post">
              <div class="when">
                <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                {p.data.version && <span class="chip chip--ver">{p.data.version}</span>}
              </div>
              <a class="panel entry" href={url(`devlog/${p.id}/`)}>
                {p.data.cover && <Img src={p.data.cover.src} alt={p.data.cover.alt} class="cover brushed" sizes="(min-width: 900px) 360px, 100vw" />}
                <div class="entry-body">
                  <h2>{p.data.title}</h2>
                  <p>{p.data.summary}</p>
                  {p.data.tags.length > 0 && (
                    <ul class="tags" aria-label="Tags">
                      {p.data.tags.map((t) => (
                        <li>#{t}</li>
                      ))}
                    </ul>
                  )}
                  <span class="more">
                    Read the post
                    {p.data.screenshots.length > 0 && <span class="shots">{` · ${p.data.screenshots.length} screenshot${p.data.screenshots.length === 1 ? "" : "s"}`}</span>}
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="roadmap" class="section roadmap band" aria-labelledby="roadmap-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Roadmap</p>
          <h2 id="roadmap-title">What's planned</h2>
        </div>
        <p>These plans may change as development goes on.</p>
      </div>
      <ol class="phases">
        {
          roadmap.map((r) => (
            <li class:list={["panel", "phase", `phase--${r.status}`]}>
              <p class="phase-tag">{r.phase}</p>
              <h3>{r.title}</h3>
              <ul class="checks">
                {r.items.map((it) => (
                  <li class:list={{ done: it.done }}>
                    <span class="box" aria-hidden="true" />
                    {it.text}
                    {it.done && <span class="visually-hidden"> (done)</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .jump {
    margin-top: 16px;
  }

  .posts {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post {
    display: grid;
    gap: 10px 32px;
  }

  @media (min-width: 900px) {
    .post {
      grid-template-columns: 170px 1fr;
    }
  }

  .when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    align-content: start;
  }

  @media (min-width: 900px) {
    .when {
      position: relative;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 10px;
    }

    /* A bone tick on the timeline, joined to the post by a rule. */
    .when::before {
      content: "";
      position: absolute;
      left: 0;
      right: -32px;
      top: 0;
      height: 1px;
      background: linear-gradient(to right, var(--bone) 0 26px, var(--line) 26px);
    }
  }

  time {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--caption);
  }

  .entry {
    display: grid;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }

  .entry:hover {
    color: inherit;
    border-color: rgb(216 210 195 / 0.55);
  }

  @media (min-width: 720px) {
    .entry {
      grid-template-columns: 340px 1fr;
    }
  }

  /* Inset so the brushed edges sit inside the panel instead of touching its border. */
  .entry :global(.cover) {
    width: calc(100% - 16px);
    height: calc(100% - 16px);
    min-height: 190px;
    margin: 8px;
    object-fit: cover;
  }

  .entry-body {
    display: flex;
    flex-direction: column;
    padding: 22px 24px;
  }

  .entry-body h2 {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    margin-bottom: 0.3em;
  }

  .entry-body p {
    color: var(--bone-dim);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
    font-family: var(--font-head);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--bone-faint);
  }

  .more {
    margin-top: auto;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bone);
  }

  .shots {
    color: var(--bone-faint);
  }

  .roadmap {
    margin-top: clamp(56px, 8vw, 96px);
  }

  .phases {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .phase {
    padding: 24px;
    box-shadow: inset 0 2px 0 var(--line), var(--shadow);
  }

  .phase--now {
    box-shadow: inset 0 2px 0 var(--green), var(--shadow);
  }

  .phase--next {
    box-shadow: inset 0 2px 0 var(--crate), var(--shadow);
  }

  .phase--done {
    box-shadow: inset 0 2px 0 var(--bone), var(--shadow);
  }

  .phase-tag {
    margin: 0 0 6px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .phase--now .phase-tag {
    color: var(--green);
  }

  .phase--next .phase-tag {
    color: var(--crate);
  }

  .checks {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: var(--bone-dim);
  }

  .box {
    flex: none;
    position: relative;
    width: 18px;
    height: 18px;
    margin-top: 4px;
    border: 1px solid rgb(216 210 195 / 0.5);
    background: var(--well);
  }

  .done {
    color: var(--bone);
  }

  .done .box {
    border-color: var(--green);
  }

  .done .box::after {
    content: "";
    position: absolute;
    left: 4px;
    top: 0;
    width: 5px;
    height: 10px;
    border: solid var(--green);
    border-width: 0 3px 3px 0;
    rotate: 45deg;
  }
</style>
