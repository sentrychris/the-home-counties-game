---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Img from "../components/Img.astro";
import Gallery from "../components/Gallery.astro";
import Tasks from "../components/Tasks.astro";
import siteData from "../data/site.json";
import mapData from "../data/map.json";
import { url } from "../lib/url";
import { langOf, link, localize, t, formatDate } from "../i18n";
import { getLocalCollection } from "../i18n/content";

const lang = langOf(Astro.url);
const _ = t(lang);
const L = link(lang);
const site = localize(lang, siteData);
const map = localize(lang, mapData);

const posts = (await getLocalCollection(lang, "devlog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const markers = await getCollection("mapMarkers");
const legend = map.layers
  .filter((l) => ["starts", "exits", "scavs", "crates"].includes(l.id))
  .map((l) => ({ ...l, count: markers.filter((m) => m.data.layer === l.id).length }));

const primaryHref = site.cta.primary.href || site.cta.primary.fallback;
const [statusTop, statusBottom] = _(site.status).split("/").map((s) => s.trim());
---

<Base bodyClass="page-home">
  <!-- The title screen: the game's backdrop and wordmark, then "Press any key" carries on into the page. -->
  <section class="title-screen" aria-labelledby="hero-title" data-title-screen>
    <div class="ts-media" aria-hidden="true">
      <div class="ts-pic">
        <img
          class="ts-bg"
          src={url("images/backdrop-1200.webp")}
          srcset={`${url("images/backdrop-720.webp")} 720w, ${url("images/backdrop-1200.webp")} 1200w, ${url("images/backdrop-2000.webp")} 1672w`}
          sizes="100vw"
          alt=""
          width="1672"
          height="941"
          fetchpriority="high"
          decoding="async"
        />
        <!-- Light laid over the picture, pinned to it as it's cropped: the break in the clouds, the
             street lamp, and the far-off war flashing behind the rooftops. Lighting under Picture settings. -->
        <div class="ts-scene">
          <span class="fx-rays"></span>
          <span class="fx-lamp"></span>
        </div>
      </div>
      <div class="ts-pic ts-pic--still">
        <div class="ts-scene ts-flashes"><span class="fx-flash"></span></div>
      </div>
      <div class="mist mist--title"><span></span></div>
      <canvas class="ts-rain"></canvas>
      <div class="ts-shade"></div>
    </div>

    <div class="ts-center">
      <h1 id="hero-title" class="ts-logo">
        <img
          src={url("images/logo-1400.webp")}
          srcset={`${url("images/logo-700.webp")} 700w, ${url("images/logo-1400.webp")} 1400w`}
          sizes="(min-width: 1000px) 880px, 92vw"
          alt="The Home Counties"
          width="1400"
          height="285"
        />
      </h1>

      <a class="ts-press" href="#intel" data-press>{_("Press any key")}</a>
    </div>

    <p class="ts-corner ts-corner--left">
      {_("Milton Keynes, UK")}<br /><span>{site.coords}</span>
    </p>
    <p class="ts-corner ts-corner--right">
      {statusTop}<br /><span>{statusBottom}</span>
    </p>
    <a class="ts-scroll" href="#intel" aria-label={_("Scroll to raid intel")}><span></span></a>
  </section>

  <!-- Raid intel, laid out like the stats along the top of the game's hideout. -->
  <section id="intel" class="intel" aria-labelledby="intel-title">
    <div class="wrap">
      <div class="intel-inner panel">
        <div class="intel-where">
          <span class="badge"><Icon name="pin" /></span>
          <div>
            <h2 id="intel-title" class="caption">{_("Raid intel")}</h2>
            <p class="where">{map.name}</p>
            <p class="where-sub">{map.location}</p>
            <p class="where-area">{map.area.map((a, i) => <Fragment>{i > 0 && " · "}<span>{a}</span></Fragment>)}</p>
          </div>
        </div>
        <dl class="intel-stats">
          {
            map.intel.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {
    site.trailer && (
      <section id="trailer" class="section trailer" aria-labelledby="trailer-title">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">{_("Watch")}</p>
              <h2 id="trailer-title">{site.trailer.heading}</h2>
            </div>
            <p>{site.trailer.text}</p>
          </div>
          <div class="panel trailer-frame">
            {/* Privacy-enhanced YouTube: no cookies until the viewer presses play. */}
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${site.trailer.youtubeId}`}
              title={site.trailer.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
          {
            site.videos.length > 0 && (
              <div class="more-videos">
                <h3 class="caption more-videos-title">{_("More videos")}</h3>
                <ul class="video-list">
                  {site.videos.map((v) => (
                    <li class="panel video-card">
                      <div class="video-frame">
                        <iframe
                          src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}`}
                          title={`The Home Counties: ${v.title}`}
                          loading="lazy"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                          referrerpolicy="strict-origin-when-cross-origin"
                          allowfullscreen
                        />
                      </div>
                      <div class="video-text">
                        <h4>{v.title}</h4>
                        {v.text && <p>{v.text}</p>}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </section>
    )
  }

  <!-- The backstory in five short beats; the rest is found in the game. -->
  <section class="section band story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <div class="story-head">
        <p class="eyebrow">{site.story.eyebrow}</p>
        <h2 id="story-title">{site.story.heading}</h2>
        <p class="story-intro">{site.story.intro}</p>
        <div class="paper note story-note" role="note">
          <span class="tape" aria-hidden="true"></span>
          <p>{site.story.outro}</p>
        </div>
      </div>
      <ol class="beats">
        {
          site.story.beats.map((b, i) => (
            <li class="beat">
              <span class="beat-num caption" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{b.title}</h3>
                <p>{b.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{_("The game")}</p>
          <h2 id="features-title">{_("What's in it")}</h2>
        </div>
        <p>{map.summary}</p>
      </div>
      <ul class="features">
        {
          site.features.map((f, i) => (
            <li class="panel card feature">
              <div class="feature-top">
                <span class="badge">
                  <Icon name={f.icon} />
                </span>
                <span class="feature-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="shots-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{_("From the build")}</p>
          <h2 id="shots-title">{_("Screenshots")}</h2>
        </div>
      </div>
      <Gallery shots={site.screenshots} feature label={_("Screenshots from the prototype")} />
    </div>
  </section>

  <section class="section" aria-labelledby="loop-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{_("The raid loop")}</p>
          <h2 id="loop-title">{_("How a raid works")}</h2>
        </div>
        <a class="btn btn--small" href={L("guides/beginners-guide/")}>{_("Beginner's guide")} <Icon name="arrow" /></a>
      </div>
      <ol class="loop">
        {
          site.loop.map((step, i) => (
            <li class:list={["loop-step", { "loop-step--exit": i === site.loop.length - 1 }]}>
              <span class="loop-node" aria-hidden="true">
                {i === site.loop.length - 1 ? <Icon name="run" /> : String(i + 1).padStart(2, "0")}
              </span>
              <span class="loop-num caption" aria-hidden="true">{_("Step {n}", { n: String(i + 1).padStart(2, "0") })}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The traders' tasks, teased: the first one's briefing with the rest blacked out. -->
  <Tasks />

  <section class="section band map-teaser" aria-labelledby="map-title">
    <div class="wrap teaser-grid">
      <div class="teaser-copy">
        <p class="eyebrow">{_("Tactical map")}</p>
        <h2 id="map-title">{_("Plan your route")}</h2>
        <p>{_("An interactive map of Duncombe Street and the streets around it. Pan and zoom, turn layers on and off, and click any marker for details.")}</p>
        <ul class="legend" aria-label={_("On the map")}>
          {
            legend.map((l) => (
              <li>
                <span class:list={["lg", `lg--${l.icon}`]} style={`--c: ${l.colour}`} aria-hidden="true">
                  {l.icon === "exit" && <Icon name="run" />}
                </span>
                <span class="lg-name">{l.name}</span>
                <span class="lg-count">{l.count}</span>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--exfil" href={L("map/")}><Icon name="crosshair" />{_("Open the map")}</a>
      </div>
      <a class="teaser-map" href={L("map/")} aria-label={_("Open the interactive map of Duncombe Street")}>
        <span class="tm-print">
          <Img src={map.downloads.preview} alt="" width={960} height={1179} class="tm-img" />
        </span>
        <span class="tape tape-a" aria-hidden="true"></span>
        <span class="tape tape-b" aria-hidden="true"></span>
        <span class="tm-north" aria-hidden="true">N<i></i></span>
        <span class="tm-label caption" aria-hidden="true">{_("{name} · field copy · {size} m grid", { name: map.name, size: map.grid.size })}</span>
        <span class="teaser-note hand" aria-hidden="true">{_("Exits are the red smoke.")}</span>
      </a>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section" aria-labelledby="log-title">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">{_("Dev log")}</p>
              <h2 id="log-title">{_("Latest updates")}</h2>
            </div>
            <a class="btn btn--small" href={L("devlog/")}>{_("All posts")}</a>
          </div>
          <ul class="card-grid posts">
            {posts.map((p) => (
              <li>
                <a class="panel card post" href={L(`devlog/${p.id}/`)}>
                  {p.data.cover && (
                    <span class="post-cover-wrap brushed">
                      <Img src={p.data.cover.src} alt={p.data.cover.alt} width={800} height={450} class="post-cover" />
                    </span>
                  )}
                  <span class="post-meta">
                    <time datetime={p.data.date.toISOString()}>{formatDate(lang, p.data.date)}</time>
                    {p.data.version && <span class="chip chip--ver">{p.data.version}</span>}
                  </span>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.summary}</p>
                  <span class="more">{_("Read")}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--tight cta-section" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="panel cta">
        <div class="cta-media" aria-hidden="true"></div>
        <div class="mist mist--cta" aria-hidden="true"><span></span></div>
        <div class="cta-copy">
          <p class="eyebrow">{_(site.status)}</p>
          <h2 id="cta-title">{site.cta.heading}</h2>
          <p class="lede">{site.cta.text}</p>
        </div>
        <div class="cta-side">
          <a class="btn btn--exfil cta-go" href={L(primaryHref)}>{site.cta.primary.label}<Icon name="run" /></a>
          <a class="btn btn--block" href={L("about/")}>{_("About the game")}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Title screen: like the game, "Press any key" carries straight on in, here down to the
  // raid intel. Rain and drifting dust fall over the backdrop, a street lamp fails and the war
  // flashes beyond the rooftops while the screen is in view, unless they're turned off under
  // Picture settings or the visitor prefers less motion.
  const screen = document.querySelector<HTMLElement>("[data-title-screen]");
  if (screen) {
    const press = screen.querySelector<HTMLAnchorElement>("[data-press]")!;
    // Scrolls smoothly unless the visitor prefers less motion (scroll-behavior in global.css).
    const goIn = () => document.getElementById("intel")?.scrollIntoView();
    const atTitle = () => window.scrollY < screen.offsetHeight * 0.5;
    // Keys that already move around the page, or the focus, are left alone.
    const passKeys = ["Shift", "Control", "Alt", "Meta", "Tab", "Escape", "CapsLock", "PageUp", "PageDown", "Home", "End"];

    document.addEventListener("keydown", (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || passKeys.includes(e.key) || e.key.startsWith("Arrow")) return;
      // Only when nothing else has the focus, so links, buttons and fields keep their keys.
      if (e.target !== document.body && e.target !== press) return;
      if (!atTitle()) return;
      e.preventDefault();
      goIn();
    });
    // A click or tap on the picture counts as a key; links and buttons on it keep theirs.
    screen.addEventListener("click", (e) => {
      const control = (e.target as Element).closest("a, button");
      if (control && control !== press) return;
      e.preventDefault();
      goIn();
    });

    // The effects below run only while the title screen is on screen and the tab is showing.
    const root = document.documentElement.classList;
    let inView = true;
    const watchers: (() => void)[] = [];
    const watch = (fn: () => void) => {
      watchers.push(fn);
      fn();
    };
    const live = () => inView && !document.hidden;
    new IntersectionObserver((entries) => {
      inView = entries[0].isIntersecting;
      watchers.forEach((fn) => fn());
    }).observe(screen);
    document.addEventListener("visibilitychange", () => watchers.forEach((fn) => fn()));
    document.addEventListener("thc-fx", () => watchers.forEach((fn) => fn()));
    const dprOf = () => Math.min(window.devicePixelRatio || 1, 1.5);

    // ---------- Rain, dust, ash and the odd ember, on one canvas ----------
    // Rain and the drifting motes each have their own switch under Picture settings, but share a
    // canvas and a frame loop, so the browser has only one moving layer to put on screen.
    const canvas = screen.querySelector<HTMLCanvasElement>(".ts-rain");
    const ctx = canvas?.getContext("2d");
    if (canvas && ctx) {
      type Drop = { x: number; y: number; len: number; speed: number; alpha: number };
      type Mote = { x: number; y: number; r: number; vx: number; vy: number; a: number; ph: number; ember: boolean };
      let drops: Drop[] = [];
      let motes: Mote[] = [];
      let w = 0;
      let h = 0;
      let running = false;
      let rain = false;
      let dust = false;
      let last = 0;
      const wind = 0.16;

      // Soft round sprites, drawn once and stamped, so nothing is blurred per frame.
      const sprite = (rgb: string) => {
        const c = document.createElement("canvas");
        c.width = c.height = 32;
        const g = c.getContext("2d")!;
        const grad = g.createRadialGradient(16, 16, 0, 16, 16, 16);
        grad.addColorStop(0, `rgba(${rgb}, 1)`);
        grad.addColorStop(0.35, `rgba(${rgb}, 0.55)`);
        grad.addColorStop(1, `rgba(${rgb}, 0)`);
        g.fillStyle = grad;
        g.fillRect(0, 0, 32, 32);
        return c;
      };
      const dustSprite = sprite("226, 216, 196");
      const emberSprite = sprite("255, 150, 72");

      const newDrop = (anywhere: boolean): Drop => {
        const near = Math.random();
        return {
          x: Math.random() * (w + 200) - 100,
          y: anywhere ? Math.random() * h : -40 - Math.random() * 200,
          len: 10 + near * 22,
          speed: 700 + near * 900,
          alpha: 0.07 + near * 0.2,
        };
      };
      const newMote = (anywhere: boolean): Mote => {
        const ember = Math.random() < 0.12;
        const near = Math.random();
        return {
          x: Math.random() * w,
          y: anywhere ? Math.random() * h : ember ? h + 10 : Math.random() * h,
          r: ember ? 1.6 + near * 2.2 : 1.2 + near * 3.2,
          vx: 8 + near * 22,
          vy: ember ? -(14 + near * 26) : 2 + near * 7,
          a: ember ? 0.45 + near * 0.4 : 0.08 + near * 0.22,
          ph: Math.random() * 6.28,
          ember,
        };
      };
      const size = () => {
        const dpr = dprOf();
        w = canvas.clientWidth;
        h = canvas.clientHeight;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        drops = Array.from({ length: Math.round((w * h) / 5200) }, () => newDrop(true));
        motes = Array.from({ length: Math.round((w * h) / 22000) }, () => newMote(true));
      };
      const frame = (t: number) => {
        if (!running) return;
        const dt = Math.min(0.05, (t - (last || t)) / 1000);
        last = t;
        ctx.clearRect(0, 0, w, h);
        if (dust) {
          for (const m of motes) {
            m.ph += dt * (m.ember ? 2.4 : 0.6);
            m.x += (m.vx + Math.sin(m.ph) * 9) * dt;
            m.y += (m.vy + Math.cos(m.ph * 0.7) * 5) * dt;
            if (m.x > w + 20) m.x = -20;
            if (m.y > h + 20 || m.y < -20) Object.assign(m, newMote(false));
            // Embers flicker and fade as they rise; everything thins out towards the sky.
            const lift = m.ember ? Math.max(0, Math.min(1, m.y / h - 0.15)) : 1;
            const flicker = m.ember ? 0.65 + 0.35 * Math.sin(m.ph * 3.1) : 1;
            ctx.globalAlpha = m.a * lift * flicker * Math.min(1, (m.y / h) * 2.5);
            ctx.drawImage(m.ember ? emberSprite : dustSprite, m.x - m.r, m.y - m.r, m.r * 2, m.r * 2);
          }
          ctx.globalAlpha = 1;
        }
        if (rain) {
          ctx.lineWidth = 1;
          ctx.lineCap = "round";
          for (const d of drops) {
            d.y += d.speed * dt;
            d.x += d.speed * wind * dt;
            if (d.y - d.len > h || d.x > w + 100) Object.assign(d, newDrop(false));
            ctx.strokeStyle = `rgba(214, 220, 226, ${d.alpha})`;
            ctx.beginPath();
            ctx.moveTo(d.x, d.y);
            ctx.lineTo(d.x - d.len * wind, d.y - d.len);
            ctx.stroke();
          }
        }
        requestAnimationFrame(frame);
      };
      const update = () => {
        rain = !root.contains("fx-no-rain");
        dust = !root.contains("fx-no-particles");
        const want = live() && (rain || dust);
        if (want && !running) {
          running = true;
          last = 0;
          if (!drops.length) size();
          requestAnimationFrame(frame);
        } else if (!want && running) {
          running = false;
          ctx.clearRect(0, 0, w, h);
        }
      };

      new ResizeObserver(() => {
        if (canvas.clientWidth !== w || canvas.clientHeight !== h) size();
      }).observe(canvas);
      watch(update);
    }

    // ---------- The far-off war, flashing beyond the rooftops now and then ----------
    const scene = screen.querySelector<HTMLElement>(".ts-flashes");
    if (scene) {
      let timer = 0;
      const next = (first = false) => {
        clearTimeout(timer);
        if (!live() || root.contains("fx-no-light")) return;
        timer = window.setTimeout(fire, (first ? 2500 : 5000) + Math.random() * 9000);
      };
      const fire = () => {
        scene.style.setProperty("--flash-x", `${6 + Math.random() * 62}%`);
        scene.classList.add("is-flash");
        // Take it off afterwards, so the glow isn't kept as a layer between flashes.
        window.setTimeout(() => scene.classList.remove("is-flash"), 2600);
        next();
      };
      watch(() => next(true));
    }
  }
</script>

<style>
  /* ---------- Title screen ---------- */

  .title-screen {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    margin-top: calc(-1 * var(--header-h));
    min-height: max(620px, 100svh);
    padding: calc(var(--header-h) + 4vh) var(--gutter) 0;
    overflow: hidden;
    isolation: isolate;
  }

  .ts-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #0b0b0b;
  }

  /* The picture and the light on it drift in together. */
  .ts-pic {
    position: absolute;
    inset: 0;
    overflow: hidden;
    container-type: size;
    transform-origin: 50% 45%;
    animation: drift 26s ease-out both;
  }

  .ts-pic--still {
    animation: none;
  }

  .ts-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }

  /* The same box as the cropped picture (object-fit: cover, 50% 42%), so the light stays on
     the lamp and the clouds at any window shape. */
  .ts-scene {
    position: absolute;
    left: 50%;
    top: 42%;
    width: max(100vw, 100svh * 1672 / 941);
    width: max(100cqw, 100cqh * 1672 / 941);
    aspect-ratio: 1672 / 941;
    translate: -50% -42%;
    pointer-events: none;
  }

  /* Only the lamp and the flashes move, so the rest is painted once with the picture instead of
     being put together again every frame. */
  .ts-scene > span {
    position: absolute;
    display: block;
  }

  /* Sun through the break in the clouds. Still, so it costs nothing after the first paint;
     the dust drifting through it does the moving. */
  .fx-rays {
    right: -2%;
    top: -3%;
    width: 58%;
    height: 82%;
    background: url("../assets/fx/rays.webp") right top / 100% 100% no-repeat;
    opacity: 0.7;
  }

  /* The street lamp on the left, failing. */
  .fx-lamp {
    left: 18.1%;
    top: 20.6%;
    width: 11%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
