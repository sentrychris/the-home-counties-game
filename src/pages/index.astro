---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Img from "../components/Img.astro";
import Gallery from "../components/Gallery.astro";
import site from "../data/site.json";
import map from "../data/map.json";
import { url, formatDate } from "../lib/url";

const posts = (await getCollection("devlog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const markers = await getCollection("mapMarkers");
const legend = map.layers
  .filter((l) => ["starts", "exits", "scavs", "crates"].includes(l.id))
  .map((l) => ({ ...l, count: markers.filter((m) => m.data.layer === l.id).length }));

const primaryHref = site.cta.primary.href || site.cta.primary.fallback;
const [statusTop, statusBottom] = site.status.split("/").map((s) => s.trim());
---

<Base bodyClass="page-home">
  <!-- The title screen: the game's backdrop and wordmark, "Press any key", then the menu. -->
  <section class="title-screen" aria-labelledby="hero-title" data-title-screen>
    <div class="ts-media" aria-hidden="true">
      <img
        class="ts-bg"
        src={url("images/backdrop-1200.webp")}
        srcset={`${url("images/backdrop-720.webp")} 720w, ${url("images/backdrop-1200.webp")} 1200w, ${url("images/backdrop-2000.webp")} 1672w`}
        sizes="100vw"
        alt=""
        width="1672"
        height="941"
        fetchpriority="high"
        decoding="async"
      />
      <canvas class="ts-rain"></canvas>
      <div class="ts-shade"></div>
    </div>

    <div class="ts-center">
      <h1 id="hero-title" class="ts-logo">
        <img
          src={url("images/logo-1400.webp")}
          srcset={`${url("images/logo-700.webp")} 700w, ${url("images/logo-1400.webp")} 1400w`}
          sizes="(min-width: 1000px) 880px, 92vw"
          alt="The Home Counties"
          width="1400"
          height="285"
        />
      </h1>

      <button class="ts-press" type="button" data-press>Press any key</button>

      <div class="ts-menu" id="title-menu">
        <p class="tagline">{site.tagline}</p>
        <nav class="ts-buttons" aria-label="Start">
          <a class="btn btn--exfil" href={url(primaryHref)}><Icon name="run" />{site.cta.primary.label}</a>
          {site.trailer && <a class="btn btn--ghost" href="#trailer"><Icon name="play" />Watch the trailer</a>}
          <a class="btn btn--ghost" href={url(site.cta.secondary.href)}><Icon name="crosshair" />{site.cta.secondary.label}</a>
          <a class="btn btn--ghost" href={url("guides/beginners-guide/")}><Icon name="toolbox" />Read the beginner's guide</a>
        </nav>
        <p class="meta">Built with {site.engine} and Claude.</p>
      </div>
    </div>

    <p class="ts-corner ts-corner--left">
      Milton Keynes, UK<br /><span>{site.coords}</span>
    </p>
    <p class="ts-corner ts-corner--right">
      {statusTop}<br /><span>{statusBottom}</span>
    </p>
    <a class="ts-scroll" href="#intel" aria-label="Scroll to raid intel"><span></span></a>
  </section>

  <!-- Raid intel, laid out like the stats along the top of the game's hideout. -->
  <section id="intel" class="intel" aria-labelledby="intel-title">
    <div class="wrap">
      <div class="intel-inner panel">
        <div class="intel-where">
          <span class="badge"><Icon name="pin" /></span>
          <div>
            <h2 id="intel-title" class="caption">Raid intel</h2>
            <p class="where">{map.name}</p>
            <p class="where-sub">{map.location}</p>
            <p class="where-area">{map.area.map((a, i) => <Fragment>{i > 0 && " · "}<span>{a}</span></Fragment>)}</p>
          </div>
        </div>
        <dl class="intel-stats">
          {
            map.intel.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {
    site.trailer && (
      <section id="trailer" class="section trailer" aria-labelledby="trailer-title">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">Watch</p>
              <h2 id="trailer-title">Trailer</h2>
            </div>
            <p>{site.trailer.text}</p>
          </div>
          <div class="panel trailer-frame">
            {/* Privacy-enhanced YouTube: no cookies until the viewer presses play. */}
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${site.trailer.youtubeId}`}
              title={site.trailer.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        </div>
      </section>
    )
  }

  <!-- The backstory in five short beats; the rest is found in the game. -->
  <section class="section band story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <div class="story-head">
        <p class="eyebrow">{site.story.eyebrow}</p>
        <h2 id="story-title">{site.story.heading}</h2>
        <p class="story-intro">{site.story.intro}</p>
        <div class="paper note story-note" role="note">
          <span class="tape" aria-hidden="true"></span>
          <p>{site.story.outro}</p>
        </div>
      </div>
      <ol class="beats">
        {
          site.story.beats.map((b, i) => (
            <li class="beat">
              <span class="beat-num caption" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{b.title}</h3>
                <p>{b.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The game</p>
          <h2 id="features-title">What's in it</h2>
        </div>
        <p>{map.summary}</p>
      </div>
      <ul class="features">
        {
          site.features.map((f, i) => (
            <li class="panel card feature">
              <div class="feature-top">
                <span class="badge">
                  <Icon name={f.icon} />
                </span>
                <span class="feature-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="shots-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">From the build</p>
          <h2 id="shots-title">Screenshots</h2>
        </div>
        <p>Taken in the current prototype build. Select one to see it full size.</p>
      </div>
      <Gallery shots={site.screenshots} feature label="Screenshots from the prototype" />
    </div>
  </section>

  <section class="section" aria-labelledby="loop-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The raid loop</p>
          <h2 id="loop-title">How a raid works</h2>
        </div>
        <a class="btn btn--small" href={url("guides/beginners-guide/")}>Beginner's guide <Icon name="arrow" /></a>
      </div>
      <ol class="loop">
        {
          site.loop.map((step, i) => (
            <li class:list={["loop-step", { "loop-step--exit": i === site.loop.length - 1 }]}>
              <span class="loop-node" aria-hidden="true">
                {i === site.loop.length - 1 ? <Icon name="run" /> : String(i + 1).padStart(2, "0")}
              </span>
              <span class="loop-num caption" aria-hidden="true">Step {String(i + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section band map-teaser" aria-labelledby="map-title">
    <div class="wrap teaser-grid">
      <div class="teaser-copy">
        <p class="eyebrow">Tactical map</p>
        <h2 id="map-title">Plan your route</h2>
        <p>An interactive map of Duncombe Street and the streets around it. Pan and zoom, turn layers on and off, and click any marker for details.</p>
        <ul class="legend" aria-label="On the map">
          {
            legend.map((l) => (
              <li>
                <span class:list={["lg", `lg--${l.icon}`]} style={`--c: ${l.colour}`} aria-hidden="true">
                  {l.icon === "exit" && <Icon name="run" />}
                </span>
                <span class="lg-name">{l.name}</span>
                <span class="lg-count">{l.count}</span>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--exfil" href={url("map/")}><Icon name="crosshair" />Open the map</a>
      </div>
      <a class="teaser-map" href={url("map/")} aria-label="Open the interactive map of Duncombe Street">
        <span class="tm-print">
          <Img src={map.downloads.preview} alt="" width={960} height={1179} class="tm-img" />
        </span>
        <span class="tape tape-a" aria-hidden="true"></span>
        <span class="tape tape-b" aria-hidden="true"></span>
        <span class="tm-north" aria-hidden="true">N<i></i></span>
        <span class="tm-label caption" aria-hidden="true">{map.name} · field copy · {map.grid.size} m grid</span>
        <span class="teaser-note hand" aria-hidden="true">Exits are the red smoke.</span>
      </a>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section" aria-labelledby="log-title">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">Dev log</p>
              <h2 id="log-title">Latest updates</h2>
            </div>
            <a class="btn btn--small" href={url("devlog/")}>All posts</a>
          </div>
          <ul class="card-grid posts">
            {posts.map((p) => (
              <li>
                <a class="panel card post" href={url(`devlog/${p.id}/`)}>
                  {p.data.cover && (
                    <span class="post-cover-wrap brushed">
                      <Img src={p.data.cover.src} alt={p.data.cover.alt} width={800} height={450} class="post-cover" />
                    </span>
                  )}
                  <span class="post-meta">
                    <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                    {p.data.version && <span class="chip chip--ver">{p.data.version}</span>}
                  </span>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.summary}</p>
                  <span class="more">Read</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--tight cta-section" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="panel cta">
        <div class="cta-media" aria-hidden="true"></div>
        <div class="cta-copy">
          <p class="eyebrow">{site.status}</p>
          <h2 id="cta-title">{site.cta.heading}</h2>
          <p class="lede">{site.cta.text}</p>
        </div>
        <div class="cta-side">
          <a class="btn btn--exfil cta-go" href={url(primaryHref)}>{site.cta.primary.label}<Icon name="run" /></a>
          <a class="btn btn--block" href={url("about/")}>About the game</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Title screen: "Press any key" until the visitor does something (or a few seconds pass),
  // then the menu. Rain falls over the backdrop while the screen is in view, unless it's
  // turned off under Picture settings or the visitor prefers less motion.
  const screen = document.querySelector<HTMLElement>("[data-title-screen]");
  if (screen) {
    const press = screen.querySelector<HTMLButtonElement>("[data-press]")!;
    const menu = screen.querySelector<HTMLElement>(".ts-menu")!;
    let open = false;

    const reveal = (focusMenu = false) => {
      if (open) return;
      open = true;
      screen.classList.add("is-open");
      cleanup();
      if (focusMenu) menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
    };
    const onKey = (e: KeyboardEvent) => {
      if (["Shift", "Control", "Alt", "Meta"].includes(e.key)) return;
      // Space would also scroll the page past the menu it has just opened.
      if (e.key === " " && e.target === document.body) e.preventDefault();
      reveal(e.target === press && (e.key === "Enter" || e.key === " "));
    };
    // A click, not pointerdown: on a phone, opening on touchstart lets the same tap land on
    // the menu button that has just appeared under the finger.
    const onPointer = () => reveal();
    const timer = window.setTimeout(() => reveal(), 4500);
    const cleanup = () => {
      window.clearTimeout(timer);
      document.removeEventListener("keydown", onKey);
      screen.removeEventListener("click", onPointer);
      window.removeEventListener("scroll", onPointer);
    };
    press.addEventListener("click", () => reveal(true));
    document.addEventListener("keydown", onKey);
    screen.addEventListener("click", onPointer);
    window.addEventListener("scroll", onPointer, { passive: true, once: true });
    if (window.scrollY > 40) reveal();

    // ---------- Rain ----------
    const canvas = screen.querySelector<HTMLCanvasElement>(".ts-rain");
    const ctx = canvas?.getContext("2d");
    if (canvas && ctx) {
      type Drop = { x: number; y: number; len: number; speed: number; alpha: number };
      let drops: Drop[] = [];
      let w = 0;
      let h = 0;
      let running = false;
      let inView = true;
      let last = 0;
      const wind = 0.16;

      const size = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        w = canvas.clientWidth;
        h = canvas.clientHeight;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = Math.round((w * h) / 5200);
        drops = Array.from({ length: count }, () => newDrop(true));
      };
      const newDrop = (anywhere: boolean): Drop => {
        const near = Math.random();
        return {
          x: Math.random() * (w + 200) - 100,
          y: anywhere ? Math.random() * h : -40 - Math.random() * 200,
          len: 10 + near * 22,
          speed: 700 + near * 900,
          alpha: 0.07 + near * 0.2,
        };
      };
      const frame = (t: number) => {
        if (!running) return;
        const dt = Math.min(0.05, (t - (last || t)) / 1000);
        last = t;
        ctx.clearRect(0, 0, w, h);
        ctx.lineWidth = 1;
        ctx.lineCap = "round";
        for (const d of drops) {
          d.y += d.speed * dt;
          d.x += d.speed * wind * dt;
          if (d.y - d.len > h || d.x > w + 100) Object.assign(d, newDrop(false));
          ctx.strokeStyle = `rgba(214, 220, 226, ${d.alpha})`;
          ctx.beginPath();
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(d.x - d.len * wind, d.y - d.len);
          ctx.stroke();
        }
        requestAnimationFrame(frame);
      };
      const update = () => {
        const want = inView && !document.hidden && !document.documentElement.classList.contains("fx-no-rain");
        if (want && !running) {
          running = true;
          last = 0;
          if (!drops.length) size();
          requestAnimationFrame(frame);
        } else if (!want && running) {
          running = false;
          ctx.clearRect(0, 0, w, h);
        }
      };

      new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
        update();
      }).observe(screen);
      new ResizeObserver(() => {
        if (canvas.clientWidth !== w || canvas.clientHeight !== h) size();
      }).observe(canvas);
      document.addEventListener("visibilitychange", update);
      document.addEventListener("thc-fx", update);
      update();
    }
  }
</script>

<style>
  /* ---------- Title screen ---------- */

  .title-screen {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    margin-top: calc(-1 * var(--header-h));
    min-height: max(620px, 100svh);
    padding: calc(var(--header-h) + 4vh) var(--gutter) 0;
    overflow: hidden;
    isolation: isolate;
  }

  .ts-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #0b0b0b;
  }

  .ts-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    transform-origin: 50% 45%;
    animation: drift 26s ease-out both;
  }

  @keyframes drift {
    from {
      transform: scale(1.09);
    }
    to {
      transform: scale(1);
    }
  }

  .ts-rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  :global(.fx-no-rain) .ts-rain {
    display: none;
  }

  .ts-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.45) 0%, transparent 22%, transparent 55%, rgb(11 11 11 / 0.7) 85%, #0b0b0b 100%),
      radial-gradient(ellipse 85% 75% at 50% 45%, transparent 40%, rgb(0 0 0 / 0.6) 100%);
  }

  .ts-center {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    padding-top: clamp(24px, 12vh, 150px);
    text-align: center;
  }

  .ts-logo {
    margin: 0 0 clamp(20px, 4vh, 40px);
    -webkit-mask-image: none;
    mask-image: none;
  }

  .ts-logo img {
    width: min(880px, 92vw);
    filter: drop-shadow(0 8px 24px rgb(0 0 0 / 0.65));
  }

  /* "Press any key", with the thin rule under it, breathing slowly. */
  .ts-press {
    position: relative;
    margin-top: clamp(20px, 14vh, 150px);
    padding: 10px 28px 16px;
    border: 0;
    background: none;
    color: var(--bone);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    cursor: pointer;
    animation: breathe 2.6s ease-in-out infinite;
  }

  .ts-press::after {
    content: "";
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 0;
    height: 1px;
    background: rgb(216 210 195 / 0.75);
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  /* Without JavaScript the menu just shows. With it, it waits for a key. */
  :global(html:not(.js)) .ts-press {
    display: none;
  }

  .ts-menu {
    position: relative;
    display: grid;
    justify-items: center;
    width: min(420px, 100%);
  }

  .ts-menu::before {
    content: "";
    position: absolute;
    inset: -40px -120px;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), transparent);
    pointer-events: none;
  }

  :global(.js) .title-screen:not(.is-open) .ts-menu {
    position: absolute;
    visibility: hidden;
    opacity: 0;
  }

  :global(.js) .title-screen.is-open .ts-press {
    display: none;
  }

  .title-screen.is-open .ts-menu > * {
    animation: rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .title-screen.is-open .ts-menu > :nth-child(2) {
    animation-delay: 0.08s;
  }

  .title-screen.is-open .ts-menu > :nth-child(3) {
    animation-delay: 0.16s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .tagline {
    margin: 0 0 22px;
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.5;
    color: var(--text);
    text-shadow: 0 2px 10px rgb(0 0 0 / 0.9);
  }

  .ts-buttons {
    display: grid;
    gap: 10px;
    width: 100%;
  }

  .ts-buttons .btn {
    justify-content: flex-start;
    min-height: 54px;
    padding-inline: 18px;
  }

  .ts-buttons .btn--exfil {
    justify-content: center;
  }

  .ts-buttons .btn--ghost {
    --fill: 14 14 14;
    background-color: rgb(var(--fill) / 0.72);
    backdrop-filter: blur(2px);
  }

  .meta {
    margin: 18px 0 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--caption);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.9);
  }

  /* The title screen's corner captions. */
  .ts-corner {
    position: absolute;
    bottom: clamp(18px, 4vh, 40px);
    margin: 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.78rem;
    line-height: 1.9;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgb(216 210 195 / 0.8);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.9);
  }

  .ts-corner span {
    white-space: pre;
  }

  .ts-corner--left {
    left: clamp(16px, 3vw, 48px);
  }

  .ts-corner--right {
    right: clamp(16px, 3vw, 48px);
    text-align: right;
  }

  .ts-scroll {
    position: absolute;
    left: 50%;
    bottom: 14px;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }

  .ts-scroll span {
    width: 1px;
    height: 26px;
    background: linear-gradient(to bottom, transparent, var(--bone));
    animation: drip 2.2s ease-in-out infinite;
  }

  @keyframes drip {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  .ts-note {
    position: absolute;
    right: clamp(16px, 6vw, 110px);
    top: calc(var(--header-h) + clamp(28px, 7vh, 80px));
    transform: rotate(3deg);
    font-size: 1.55rem;
    max-width: 230px;
    padding: 16px 20px 14px;
  }

  @media (max-width: 899px) {
    .ts-note {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .ts-corner {
      font-size: 0.68rem;
      letter-spacing: 0.18em;
    }

    .ts-scroll {
      display: none;
    }
  }

  @media (max-height: 760px) and (min-width: 641px) {
    .ts-center {
      padding-top: 4vh;
    }
  }

  /* ---------- Raid intel ---------- */

