---
// Link columns over the game's bottom bar: where you are on the left, the build on the right.
import site from "../data/site.json";
import map from "../data/map.json";
import { url } from "../lib/url";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
const more = [
  { label: "Guides", href: "guides/" },
  { label: "Gear database", href: "gear/" },
  { label: "Roadmap", href: "devlog/#roadmap" },
  { label: "Credits", href: "credits/" },
];
const [statusTop] = site.status.split("/").map((s) => s.trim());
const town = map.location.split("·")[0].trim();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="about">
      <img src={url("images/logo-700.webp")} alt="The Home Counties" width="700" height="142" loading="lazy" />
      <p>{site.description}</p>
      <p class="made">Made in {site.engine} by {site.developer}.</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="col-title">Site</h2>
      <ul>
        {site.nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="More">
      <h2 class="col-title">More</h2>
      <ul>
        {more.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="col-title">Follow</h2>
      <ul>
        {
          site.links.map((l) =>
            l.href ? (
              <li><a href={l.href} rel="me noopener">{l.label}</a></li>
            ) : (
              <li class="soon">{l.label} <span>coming soon</span></li>
            )
          )
        }
      </ul>
    </div>
  </div>

  <div class="bottom-bar">
    <div class="where">
      <Icon name="pin" />
      <p>
        <span class="where-name">{map.name}, {town}</span>
        <span class="where-coords">{site.coords}</span>
      </p>
    </div>
    <div class="legal">
      <p>© {year} {site.developer}. {site.name} is a work in progress; everything here may change.</p>
      <p>Street data © OpenStreetMap contributors. Not affiliated with any real business shown. <a href={url("credits/")}>Asset credits</a>.</p>
    </div>
    <p class="build">
      <span>{statusTop}</span>
      {site.version}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(32px, 5vw, 64px);
    padding-top: clamp(40px, 6vw, 72px);
    background-color: rgb(8 8 8 / 0.9);
    background-image: linear-gradient(rgb(8 8 8 / 0.82), rgb(8 8 8 / 0.82)), var(--grunge);
    background-size: auto, 1024px;
    border-top: 1px solid var(--line-soft);
    font-size: 0.98rem;
    color: var(--caption);
  }

  .cols {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    padding-bottom: clamp(36px, 5vw, 56px);
  }

  @media (min-width: 720px) {
    .cols {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .about img {
    width: 220px;
    margin-bottom: 16px;
    opacity: 0.92;
  }

  .about p {
    max-width: 44ch;
  }

  .made {
    font-family: var(--font-hand);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--bone);
  }

  .col-title {
    margin-bottom: 14px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.26em;
    color: var(--dim);
    -webkit-mask-image: none;
    mask-image: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  a {
    color: var(--caption);
    text-decoration: none;
  }

  a:hover {
    color: var(--bone-light);
    text-decoration: underline;
  }

  .soon {
    color: var(--dim);
  }

  .soon span {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-left: 6px;
    border: 1px solid var(--line);
    padding: 1px 6px;
  }

  /* The game's bottom bar. */
  .bottom-bar {
    display: grid;
    gap: 16px 32px;
    align-items: center;
    padding: 18px clamp(16px, 2.4vw, 32px) 22px;
    border-top: 1px solid var(--line);
    background: rgb(4 4 4 / 0.6);
  }

  @media (min-width: 960px) {
    .bottom-bar {
      grid-template-columns: auto 1fr auto;
    }
  }

  .where {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .where :global(.icon) {
    width: 24px;
    height: 24px;
    color: var(--caption);
  }

  .where p,
  .build {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.45;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .where-name {
    display: block;
    color: var(--text);
  }

  .where-coords {
    display: block;
    color: var(--dim);
    white-space: pre;
  }

  .legal {
    font-size: 0.85rem;
    color: var(--dim);
  }

  @media (min-width: 960px) {
    .legal {
      text-align: center;
    }
  }

  .legal p {
    margin: 0 0 2px;
  }

  .legal a {
    color: var(--dim);
    text-decoration: underline;
  }

  .build {
    color: var(--caption);
  }

  .build span {
    display: block;
  }

  @media (min-width: 960px) {
    .build {
      text-align: right;
    }
  }
</style>
