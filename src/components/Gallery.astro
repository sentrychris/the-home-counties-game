---
// Screenshot grid with a keyboard-friendly lightbox. Works without JS (links open the image).
import { url, publicFileExists, screenshotSrcset } from "../lib/url";
import Placeholder from "./Placeholder.astro";
import Icon from "./Icon.astro";

interface Shot {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  shots: Shot[];
  /** Make the first shot large. */
  feature?: boolean;
  label?: string;
}

const { shots, feature = false, label = "Screenshots" } = Astro.props;
---

<div class:list={["gallery", { "gallery--feature": feature }]} data-gallery>
  <ul class="shots" aria-label={label}>
    {
      shots.map((s, i) => (
        <li>
          <figure>
            {publicFileExists(s.src) ? (
              <a href={url(s.src)} data-index={i} data-caption={s.caption ?? ""} data-alt={s.alt}>
                <img
                  src={url(s.src)}
                  srcset={screenshotSrcset(s.src)}
                  sizes={feature && i === 0 ? "(min-width: 900px) 66vw, 100vw" : "(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw"}
                  alt={s.alt}
                  width="1600"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
                <span class="zoom" aria-hidden="true"><Icon name="plus" /></span>
              </a>
            ) : (
              <Placeholder label={s.alt} path={`public/${s.src}`} />
            )}
            {s.caption && (
              <figcaption>
                <span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                {s.caption}
              </figcaption>
            )}
          </figure>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Screenshot viewer">
    <div class="lb-frame">
      <img alt="" />
      <div class="lb-bar">
        <p class="lb-caption"></p>
        <span class="lb-count" aria-live="polite"></span>
        <div class="lb-buttons">
          <button type="button" class="lb-prev" aria-label="Previous screenshot"><Icon name="arrow" class="flip" /></button>
          <button type="button" class="lb-next" aria-label="Next screenshot"><Icon name="arrow" /></button>
          <button type="button" class="lb-close" aria-label="Close"><Icon name="close" /></button>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>("a[data-index]")];
    const dialog = gallery.querySelector<HTMLDialogElement>(".lightbox");
    if (!dialog || !links.length) continue;
    const img = dialog.querySelector("img")!;
    const caption = dialog.querySelector(".lb-caption")!;
    const count = dialog.querySelector(".lb-count")!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const a = links[current];
      img.src = a.href;
      img.alt = a.dataset.alt ?? "";
      caption.textContent = a.dataset.caption || a.dataset.alt || "";
      count.textContent = `${current + 1} / ${links.length}`;
    };

    links.forEach((a, i) =>
      a.addEventListener("click", (e) => {
        e.preventDefault();
        opener = a;
        show(i);
        dialog.showModal();
      })
    );
    dialog.querySelector(".lb-prev")!.addEventListener("click", () => show(current - 1));
    dialog.querySelector(".lb-next")!.addEventListener("click", () => show(current + 1));
    dialog.querySelector(".lb-close")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
    dialog.addEventListener("close", () => opener?.focus());
  }
</script>

<style>
  .shots {
    display: grid;
    gap: clamp(10px, 1.6vw, 16px);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .gallery--feature .shots {
      grid-template-columns: repeat(3, 1fr);
    }
    .gallery--feature li:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Each shot is painted onto the page with dry-brushed edges. */
  figure a {
    position: relative;
    display: block;
    flex: 1;
    min-height: 0;
    -webkit-mask: url("../assets/textures/brush-frame.png") center / 100% 100% no-repeat;
    mask: url("../assets/textures/brush-frame.png") center / 100% 100% no-repeat;
  }

  /* The mask would clip a normal outline, so focus draws inside the image instead. */
  figure a:focus-visible {
    outline: none;
  }

  figure a:focus-visible::after {
    content: "";
    position: absolute;
    inset: 10px;
    z-index: 2;
    border: 3px solid var(--bone);
  }

  figure img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.05);
    transition: transform 0.5s ease, filter 0.4s;
  }

  figure a:hover img,
  figure a:focus-visible img {
    transform: scale(1.03);
    filter: saturate(1) contrast(1.05);
  }

  .zoom {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: rgb(11 11 11 / 0.85);
    border: 1px solid var(--edge-strong);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .zoom :global(.icon) {
    width: 18px;
    height: 18px;
  }

  figure a:hover .zoom,
  figure a:focus-visible .zoom {
    opacity: 1;
  }

  figcaption {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 9px 2px 0;
    font-size: 0.96rem;
    color: var(--caption);
  }

  .num {
    font-family: var(--font-head);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--red-text);
  }

  .lightbox {
    width: min(1440px, 96vw);
    max-height: 96vh;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: #0b0b0b;
    color: var(--text);
  }

  .lightbox::backdrop {
    background: rgb(4 4 4 / 0.9);
  }

  .lb-frame img {
    width: 100%;
    max-height: calc(96vh - 72px);
    object-fit: contain;
    background: #000;
  }

  .lb-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    background-color: rgb(17 17 18);
    background-image: linear-gradient(rgb(17 17 18 / 0.76), rgb(17 17 18 / 0.76)), var(--grunge);
    background-size: auto, 1024px;
  }

  .lb-caption {
    margin: 0;
    flex: 1 1 240px;
    color: var(--caption);
  }

  .lb-count {
    font-family: var(--font-head);
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--dim);
  }

  .lb-buttons {
    display: flex;
    gap: 6px;
  }

  .lb-buttons button {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--edge-strong);
    background: rgb(24 24 25);
    color: var(--text);
    cursor: pointer;
  }

  .lb-buttons button:hover {
    border-color: rgb(216 210 195 / 0.6);
    color: var(--bone-light);
  }

  .lb-buttons :global(.icon) {
    width: 20px;
    height: 20px;
  }

  .lb-buttons :global(.flip) {
    transform: scaleX(-1);
  }
</style>
