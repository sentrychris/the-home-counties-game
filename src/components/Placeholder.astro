---
// Marks a spot where art still needs dropping in. The path tells you where.
interface Props {
  label: string;
  path?: string;
  class?: string;
  aspect?: string;
}
import { langOf, t } from "../i18n";
const { label, path, class: cls, aspect = "16 / 9" } = Astro.props;
const _ = t(langOf(Astro.url));
---

<div class:list={["placeholder", cls]} style={`aspect-ratio: ${aspect}`} role="img" aria-label={`${_("Image to come")}: ${label}`}>
  <strong>{_("Image to come")}</strong>
  <span>{label}</span>
  {path && <code>{path}</code>}
</div>
