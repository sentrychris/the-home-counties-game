---
// The game's top bar: wordmark, tabs (the picked one in a lighter worn box with a bone line
// on the bar's edge), and on the right the build and a Picture settings button.
import site from "../data/site.json";
import { url, isCurrent } from "../lib/url";
import Icon from "./Icon.astro";

const pathname = Astro.url.pathname;
const [statusTop] = site.status.split("/").map((s) => s.trim());
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href={url()}>
      <img src={url("images/logo-700.webp")} alt="The Home Counties, home" width="700" height="142" />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="when-closed"><Icon name="menu" /></span>
      <span class="when-open"><Icon name="close" /></span>
      <span class="menu-label">Menu</span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isCurrent(pathname, item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="bar-end">
      <p class="build-tag" title="Current build">
        <span>{statusTop}</span>
        {site.version}
      </p>
      <div class="fx">
        <button class="icon-btn fx-toggle" type="button" aria-expanded="false" aria-controls="fx-panel" aria-label="Picture settings">
          <Icon name="settings" />
        </button>
        <div id="fx-panel" class="fx-panel" hidden>
          <p class="fx-title">Picture</p>
          <label class="toggle">
            <input type="checkbox" data-fx="grain" checked />
            <span class="toggle-box" aria-hidden="true"></span>
            <span>Film grain</span>
          </label>
          <label class="toggle">
            <input type="checkbox" data-fx="rain" checked />
            <span class="toggle-box" aria-hidden="true"></span>
            <span>Rain on the title screen</span>
          </label>
          <p class="fx-note">Saved in this browser.</p>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.getElementById("site-nav");

  // See-through over the home page's title screen; a dark bar once you scroll.
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 24);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("is-open", open);
      header?.classList.toggle("is-menu-open", open);
    };
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia("(min-width: 1100px)").addEventListener("change", () => setOpen(false));
  }

  // Picture settings: film grain and rain, remembered in this browser only.
  const fxBtn = document.querySelector<HTMLButtonElement>(".fx-toggle");
  const fxPanel = document.getElementById("fx-panel");
  if (fxBtn && fxPanel) {
    const STORE = "thc-fx-v1";
    const root = document.documentElement.classList;
    const read = (): Record<string, boolean> => {
      try {
        return JSON.parse(localStorage.getItem(STORE) ?? "{}");
      } catch {
        return {};
      }
    };
    const setPanel = (open: boolean) => {
      fxPanel.hidden = !open;
      fxBtn.setAttribute("aria-expanded", String(open));
    };
    for (const box of fxPanel.querySelectorAll<HTMLInputElement>("input[data-fx]")) {
      const key = box.dataset.fx!;
      box.checked = !root.contains(`fx-no-${key}`);
      box.addEventListener("change", () => {
        root.toggle(`fx-no-${key}`, !box.checked);
        const fx = read();
        fx[key] = box.checked;
        try {
          localStorage.setItem(STORE, JSON.stringify(fx));
        } catch {
          /* storage unavailable: the choice lasts until the page changes */
        }
        document.dispatchEvent(new CustomEvent("thc-fx", { detail: { key, on: box.checked } }));
      });
    }
    fxBtn.addEventListener("click", () => setPanel(fxPanel.hidden));
    document.addEventListener("click", (e) => {
      if (!fxPanel.hidden && !(e.target as Element).closest(".fx")) setPanel(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !fxPanel.hidden) {
        setPanel(false);
        fxBtn.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 500;
  }

  /* The bar: near-black and scuffed, with a hairline along its bottom edge. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: rgb(9 9 9 / 0.94);
    background-image: linear-gradient(rgb(9 9 9 / 0.8), rgb(9 9 9 / 0.8)), var(--grunge);
    background-size: auto, 1024px;
    border-bottom: 1px solid var(--line-soft);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.4);
    transition: opacity 0.3s ease;
  }

  /* Over the title screen the bar starts see-through, with a soft shade to keep the tabs legible. */
  :global(.page-home) .site-header:not(.is-scrolled):not(.is-menu-open)::before {
    opacity: 0;
  }

  :global(.page-home) .site-header::after {
    content: "";
    position: absolute;
    inset: 0 0 -40px;
    z-index: -2;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.65), transparent);
    pointer-events: none;
  }

  .bar {
    display: flex;
    align-items: stretch;
    gap: clamp(12px, 2vw, 28px);
    min-height: var(--header-h);
    padding-inline: clamp(16px, 2.4vw, 32px);
  }

  .brand {
    flex: none;
    display: flex;
    align-items: center;
    padding: 6px 0;
  }

  .brand img {
    height: 34px;
    width: auto;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.7));
  }

  .menu-toggle {
    display: none;
    align-self: center;
    margin-left: auto;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--edge-strong);
    background: rgb(17 17 18 / 0.7);
    color: var(--text);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .menu-toggle :global(.icon) {
    width: 22px;
    height: 22px;
  }

  .menu-toggle .when-open,
  .menu-toggle[aria-expanded="true"] .when-closed {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .when-open {
    display: inline;
  }

  .nav {
    display: flex;
    align-items: stretch;
  }

  .nav ul {
    display: flex;
    align-items: stretch;
    gap: 2px;
    margin: 0;
    padding: 8px 0 0;
    list-style: none;
  }

  .nav li {
    display: flex;
  }

  /* Tabs: no box until picked. */
  .nav a {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 clamp(10px, 1.1vw, 16px) 6px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(179 174 163 / 0.95);
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.85);
    border: 1px solid transparent;
    border-bottom: 0;
    transition: color 0.15s, background-color 0.15s;
  }

  .nav a:hover {
    color: var(--bone-light);
    background: rgb(255 255 255 / 0.035);
  }

  /* The picked tab: a lighter worn box with a bone line sitting on the bar's edge. */
  .nav a[aria-current="page"] {
    color: var(--bone-light);
    background-color: rgb(43 43 41 / 0.96);
    background-image: linear-gradient(rgb(43 43 41 / 0.58), rgb(43 43 41 / 0.58)), var(--grunge);
    background-size: auto, 1024px;
    border-color: rgb(255 255 255 / 0.14);
    box-shadow: inset 0 -2px 0 rgb(216 210 195 / 0.85);
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
  }

  .build-tag {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.82rem;
    line-height: 1.35;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-align: right;
    color: var(--caption);
    white-space: nowrap;
  }

  .build-tag span {
    display: block;
  }

  .fx {
    position: relative;
  }

  /* Square icon button, like the cog and exit buttons in the game's top-right corner. */
  .icon-btn {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 1px solid var(--edge-strong);
    background-color: rgb(24 24 25 / 0.95);
    background-image: linear-gradient(rgb(24 24 25 / 0.76), rgb(24 24 25 / 0.76)), var(--grunge);
    background-size: auto, 1024px;
    color: var(--text);
    cursor: pointer;
  }

  .icon-btn:hover,
  .icon-btn[aria-expanded="true"] {
    border-color: rgb(216 210 195 / 0.55);
    color: var(--bone-light);
  }

  .icon-btn :global(.icon) {
    width: 24px;
    height: 24px;
  }

  .fx-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    z-index: 10;
    width: 270px;
    padding: 16px 18px 12px;
    background-color: rgb(25 25 26 / 0.98);
    background-image: linear-gradient(rgb(25 25 26 / 0.7), rgb(25 25 26 / 0.7)), var(--grunge);
    background-size: auto, 1024px;
    border: 1px solid rgb(255 255 255 / 0.2);
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.6);
  }

  .fx-title {
    margin: 0 0 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    cursor: pointer;
    font-size: 1rem;
  }

  .toggle input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  /* A square check, like the game's: empty when off, a bone square inside when on. */
  .toggle-box {
    flex: none;
    position: relative;
    width: 20px;
    height: 20px;
    border: 1px solid rgb(216 210 195 / 0.6);
    background: var(--well);
  }

  .toggle input:checked + .toggle-box::after {
    content: "";
    position: absolute;
    inset: 4px;
    background: var(--bone);
  }

  .toggle input:focus-visible + .toggle-box {
    outline: 2px solid var(--bone);
    outline-offset: 2px;
  }

  .fx-note {
    margin: 6px 0 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  @media (max-width: 1099px) {
    .menu-toggle {
      display: inline-flex;
    }

    .bar-end {
      margin-left: 0;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 10px clamp(16px, 2.4vw, 32px) 22px;
      background-color: rgb(14 14 15 / 0.98);
      background-image: linear-gradient(rgb(14 14 15 / 0.8), rgb(14 14 15 / 0.8)), var(--grunge);
      background-size: auto, 1024px;
      border-bottom: 1px solid var(--line);
      box-shadow: 0 20px 40px rgb(0 0 0 / 0.55);
      max-height: calc(100vh - var(--header-h));
      overflow-y: auto;
    }

    .nav.is-open {
      display: block;
    }

    .nav ul {
      flex-direction: column;
      padding: 0;
    }

    .nav a {
      padding: 14px 14px;
      font-size: 1.4rem;
      border: 0;
      border-bottom: 1px solid var(--line-soft);
      text-shadow: none;
    }

    .nav a[aria-current="page"] {
      box-shadow: inset 2px 0 0 rgb(216 210 195 / 0.85);
    }
  }

  @media (max-width: 599px) {
    .build-tag {
      display: none;
    }

    .brand img {
      height: 28px;
    }

    .menu-label {
      display: none;
    }
  }
</style>
