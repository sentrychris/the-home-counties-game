---
// The home page's tasks teaser (src/data/tasks.json): the first task's briefing on a sheet of
// paper with the later objectives blacked out, a screenshot with the game's OBJECTIVE COMPLETE box
// sliding in, and the other traders' first tasks by name only. Deliberately gives little away.
import Icon from "./Icon.astro";
import Img from "./Img.astro";
import tasks from "../data/tasks.json";
import { url } from "../lib/url";

const b = tasks.briefing;
const bg = `--tasks-bg: url("${url("images/screenshots/dl-mist-rail-south-800.webp")}")`;
---

<section id="tasks" class="section tasks" aria-labelledby="tasks-title" style={bg} data-tasks>
  <div class="tasks-backdrop" aria-hidden="true"></div>
  <div class="mist mist--tasks" aria-hidden="true"><span></span></div>

  <div class="wrap tasks-grid">
    <div class="tasks-copy">
      <p class="eyebrow">{tasks.eyebrow}</p>
      <h2 id="tasks-title">{tasks.heading}</h2>
      <p class="tasks-intro">{tasks.intro}</p>

      <dl class="tasks-stats">
        {
          tasks.stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>

      <ul class="tasks-others" aria-label="More tasks">
        {
          tasks.others.map((o) => (
            <li>
              <span class="to-trader">{o.trader}</span>
              <span class="to-title">{o.title}</span>
              <span class="to-area">
                <Icon name="pin" />
                {o.area}
              </span>
            </li>
          ))
        }
        <li class="to-locked">
          <span class="to-trader">Stages 2 and 3</span>
          <span class="to-title">Locked</span>
          <span class="to-area">{tasks.locked}</span>
        </li>
      </ul>

      <a class="btn btn--small" href={url("traders/")}>Meet the traders <Icon name="arrow" /></a>
    </div>

    <div class="tasks-media">
      <figure class="tasks-shot">
        <div class="shot-frame">
          <Img src={tasks.shot.src} alt={tasks.shot.alt} width={1600} height={884} sizes="(min-width: 960px) 640px, 100vw" />
          {/* The in-raid box from the game, rebuilt in HTML so it can slide in. */}
          <div class="quest-toast" aria-hidden="true">
            <p class="qt-line">
              <span class="qt-head">{tasks.toast.head}</span>
              <span class="qt-text">{tasks.toast.text}</span>
            </p>
            <p class="qt-sub">{tasks.toast.sub}</p>
          </div>
        </div>
      </figure>

      <article class="paper briefing" aria-labelledby="briefing-title">
        <span class="tape" aria-hidden="true"></span>
        <header class="b-head">
          <span>{b.trader} · {b.role}</span>
          <span>{b.stage}</span>
        </header>
        <h3 id="briefing-title">{b.title}</h3>
        <p class="b-area">{b.area}</p>
        <div class="b-text">
          {b.text.map((t) => <p>{t}</p>)}
        </div>
        <p class="b-label">Objectives</p>
        <ol class="b-objectives">
          {
            b.objectives.map((o) => (
              <li class:list={{ "is-done": "done" in o && o.done }}>
                <span class="b-box" aria-hidden="true">
                  {"done" in o && o.done && (
                    <svg viewBox="0 0 24 24">
                      <path d="M4 13 L10 19 L21 5" />
                    </svg>
                  )}
                </span>
                {"text" in o ? (
                  <span>
                    {o.text}
                    {"done" in o && o.done && <span class="visually-hidden"> (done)</span>}
                  </span>
                ) : (
                  <span class="redact" style={`--w: ${o.hidden}%`}>
                    <span class="visually-hidden">Blacked out</span>
                  </span>
                )}
              </li>
            ))
          }
        </ol>
        <p class="b-reward">
          <span class="b-label">Reward</span>
          <span class="redact" style="--w: 11ch"><span class="visually-hidden">Blacked out</span></span>
        </p>
      </article>
    </div>
  </div>
</section>

<script>
  // Play the box sliding in and the tick going on once, when the section comes into view.
  const section = document.querySelector<HTMLElement>("[data-tasks]");
  if (section) {
    if (!("IntersectionObserver" in window)) section.classList.add("is-in");
    else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            section.classList.add("is-in");
            io.disconnect();
          }
        },
        { rootMargin: "0px 0px -35% 0px" },
      );
      io.observe(section);
    }
  }
</script>

<style>
  .tasks {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-block: 1px solid var(--line-soft);
  }

  /* A misty field behind it all, drained and dark. */
  .tasks-backdrop {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(to right, rgb(11 11 11 / 0.96) 25%, rgb(11 11 11 / 0.82) 60%, rgb(11 11 11 / 0.9)),
      linear-gradient(to bottom, rgb(11 11 11 / 0.6), transparent 30%, transparent 70%, rgb(11 11 11 / 0.85)),
      var(--tasks-bg) center 60% / cover no-repeat;
    filter: grayscale(0.4);
  }

  .mist--tasks {
    --mist-h: 55%;
    --mist-o: 0.22;
    z-index: -1;
  }

  .tasks-grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .tasks-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .tasks-intro {
    margin: 0.8em 0 0;
    max-width: 46ch;
    color: var(--caption);
    font-size: 1.1rem;
  }

  /* ---------- The numbers ---------- */

  .tasks-stats {
    display: flex;
    gap: clamp(20px, 4vw, 44px);
    margin: clamp(22px, 3vw, 32px) 0;
    padding: 16px 0;
    border-block: 1px solid var(--line);
  }

  .tasks-stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .tasks-stats dt {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .tasks-stats dd {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 2.6rem);
    line-height: 1.05;
    color: var(--bone);
  }

  /* ---------- Other traders' first tasks, by name only ---------- */

  .tasks-others {
    display: grid;
    gap: 0;
    margin: 0 0 clamp(22px, 3vw, 30px);
    padding: 0;
    list-style: none;
  }

  .tasks-others li {
    display: grid;
    grid-template-columns: 8.5em 1fr;
    gap: 2px 14px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .to-trader {
    grid-row: span 2;
    padding-top: 3px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .to-title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bone);
  }

  .to-area {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.92rem;
    color: var(--caption);
  }

  .to-area :global(.icon) {
    width: 14px;
    height: 14px;
    opacity: 0.7;
  }

  .to-locked .to-title {
    color: var(--dim);
  }

  .to-locked .to-area {
    color: var(--dim);
  }

  /* ---------- The screenshot and the game's box ---------- */

  .tasks-media {
    position: relative;
    display: grid;
  }

  .tasks-shot {
    margin: 0;
  }

  .shot-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #000;
    box-shadow: var(--shadow);
  }

  .shot-frame :global(img) {
    width: 100%;
    height: auto;
  }


  .quest-toast {
    position: absolute;
    top: 7%;
    right: 3%;
    max-width: 62%;
    padding: 0.55em 0.95em 0.6em 1.05em;
    background: rgb(14 14 14 / 0.86);
    box-shadow: inset 3px 0 0 var(--green), 0 6px 18px rgb(0 0 0 / 0.4);
    font-family: var(--font-head);
    font-size: clamp(0.62rem, 1.35vw, 0.92rem);
    line-height: 1.25;
    transition:
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s,
      opacity 0.4s ease 0.5s;
  }

  .quest-toast p {
    margin: 0;
  }

  .qt-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.7em;
  }

  .qt-head {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--green);
  }

  .qt-text {
    padding-left: 0.7em;
    border-left: 1px solid rgb(216 210 195 / 0.3);
    font-weight: 600;
    color: var(--bone-light);
  }

  .qt-sub {
    margin-top: 0.15em !important;
    font-size: 0.85em;
    color: var(--caption);
  }

  /* Before it scrolls into view (only when scripts run, so it's never hidden for good). */
  :global(.js) .tasks:not(:global(.is-in)) .quest-toast {
    transform: translateX(115%);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .quest-toast,
    .b-box path {
      transition: none;
    }
  }

  /* ---------- The briefing, on paper ---------- */

  .briefing {
    position: relative;
    z-index: 1;
    width: min(100%, 520px);
    margin: -14% 0 0 -6%;
    padding: 26px 28px 22px;
    transform: rotate(-1.4deg);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  @media (max-width: 959px) {
    .briefing {
      width: min(calc(100% - 10px), 520px);
      margin: -18px 0 0 4px;
    }
  }

  .briefing .tape {
    top: -14px;
    left: 42%;
    transform: rotate(3deg);
  }

  .b-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgb(38 34 28 / 0.35);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(38 34 28 / 0.75);
  }

  .briefing h3 {
    -webkit-mask-image: none;
    mask-image: none;
    margin: 12px 0 0;
    font-family: var(--font-title);
    font-size: clamp(1.7rem, 3vw, 2.1rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .b-area {
    margin: 4px 0 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(38 34 28 / 0.7);
  }

  .b-text {
    margin-top: 12px;
  }

  .b-text p {
    margin: 0 0 0.6em;
  }

  .b-label {
    margin: 14px 0 6px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.74rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(38 34 28 / 0.7);
  }

  .b-objectives {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .b-objectives li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: center;
  }

  .b-box {
    position: relative;
    width: 16px;
    height: 16px;
    border: 1.5px solid rgb(38 34 28 / 0.7);
  }

  /* The tick, drawn on in pen once the box has slid in. */
  .b-box svg {
    position: absolute;
    left: -3px;
    top: -7px;
    width: 24px;
    height: 24px;
    overflow: visible;
  }

  .b-box path {
    fill: none;
    stroke: #3b6a1f;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 30;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.45s ease-out 1.25s;
  }

  :global(.js) .tasks:not(:global(.is-in)) .b-box path {
    stroke-dashoffset: 30;
  }

  .is-done > span:last-child {
    text-decoration: line-through;
    text-decoration-color: rgb(38 34 28 / 0.45);
    text-decoration-thickness: 1px;
  }

  .b-reward {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 16px 0 0;
    padding-top: 10px;
    border-top: 1px dashed rgb(38 34 28 / 0.3);
  }

  .b-reward .b-label {
    margin: 0;
  }

  /* Blacked out in marker: slightly uneven, never quite straight. */
  .redact {
    display: inline-block;
    width: var(--w, 60%);
    height: 1.05em;
    vertical-align: middle;
    background: #161412;
    border-radius: 2px 6px 3px 5px / 5px 3px 6px 2px;
    transform: rotate(-0.4deg) skewX(-6deg);
    box-shadow: 1px 0 0 #161412, -1px 1px 0 rgb(22 20 18 / 0.7);
    -webkit-mask-image: var(--ink-light);
    mask-image: var(--ink-light);
    -webkit-mask-size: 140px;
    mask-size: 140px;
  }

  .b-objectives .redact {
    width: var(--w, 60%);
  }
</style>
