[
  {
    "group": "Movement",
    "binds": [
      { "keys": ["W", "A", "S", "D"], "action": "Move" },
      { "keys": ["Shift"], "action": "Sprint" },
      { "keys": ["Caps Lock"], "action": "Walk" },
      { "keys": ["C"], "action": "Crouch (toggle)" },
      { "keys": ["Space"], "action": "Jump or vault" },
      { "keys": ["Q", "E"], "action": "Lean left / right" }
    ]
  },
  {
    "group": "Combat",
    "binds": [
      { "keys": ["Left mouse"], "action": "Shoot" },
      { "keys": ["Right mouse"], "action": "Aim" },
      { "keys": ["R"], "action": "Reload (fullest magazine)" },
      { "keys": ["Y"], "action": "Reload with the next ammo type" },
      { "keys": ["T"], "action": "Weapon light on or off" },
      { "keys": ["Alt+T"], "action": "Check ammo" },
      { "keys": ["Alt+I"], "action": "Inspect weapon" },
      { "keys": ["1", "2"], "action": "Primary / secondary rifle" },
      { "keys": ["3"], "action": "Pistol" },
      { "keys": ["4"], "action": "Knife (left mouse slash, right mouse stab)" }
    ]
  },
  {
    "group": "Grenades",
    "binds": [
      { "keys": ["G"], "action": "Take out a grenade (again: next kind)" },
      { "keys": ["Left mouse"], "action": "Hold to pull the pin, let go to throw" },
      { "keys": ["Right mouse"], "action": "Hold, then let go to lob underhand" },
      { "keys": ["R"], "action": "Cook a frag (pin out, button held)" },
      { "keys": ["1", "2", "3", "4"], "action": "Put it away (or take out another weapon)" }
    ]
  },
  {
    "group": "Looting and survival",
    "binds": [
      { "keys": ["F"], "action": "Search, open, read" },
      { "keys": ["F"], "action": "Hold to take a paper" },
      { "keys": ["H"], "action": "Heal" },
      { "keys": ["Tab"], "action": "Gear" },
      { "keys": ["X"], "action": "Drop the item under the mouse (gear screen)" }
    ]
  },
  {
    "group": "Other",
    "binds": [
      { "keys": ["Esc"], "action": "Pause (menu only, in a squad)" },
      { "keys": ["F12"], "action": "Hide or show the HUD" },
      { "keys": ["F3"], "action": "FPS counter" },
      { "keys": ["F1"], "action": "Developer menu" }
    ]
  },
  {
    "group": "Photo mode",
    "binds": [
      { "keys": ["Right mouse"], "action": "Hold to look round" },
      { "keys": ["W", "A", "S", "D"], "action": "Move the camera" },
      { "keys": ["Space", "E"], "action": "Up" },
      { "keys": ["C", "Q"], "action": "Down" },
      { "keys": ["P", "Enter"], "action": "Take the photo" },
      { "keys": ["H", "F12"], "action": "Hide the panel" },
      { "keys": ["R"], "action": "Reset the camera" },
      { "keys": ["Esc"], "action": "Back to the menu" }
    ]
  }
]
